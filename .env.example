# ---------------------------------------------------------------
# Shopify AI Agent - variables de entorno
# Copia este archivo a .env y rellena los valores.
# NUNCA subas el .env a git (ya esta en .gitignore).
# ---------------------------------------------------------------

# Dominio de tu tienda, SIN https:// y SIN barra final.
# Lo ves en la URL del admin: admin.shopify.com/store/<algo>
SHOPIFY_SHOP=mi-tienda-dev.myshopify.com

# Credenciales de tu app del Dev Dashboard.
#
# OJO: desde el 1 de enero de 2026 Shopify ya NO deja crear las custom apps
# antiguas del admin (esas que te daban un token shpat_ para pegar aqui).
# Ahora la app se crea en el Dev Dashboard y te da Client ID + Client Secret.
# El codigo los cambia por un access token que caduca a las 24 h y se renueva
# solo. Tu no tienes que tocar ningun token.
#
# Dev Dashboard -> tu app -> Overview / Client credentials
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SOLO si tienes una app legacy creada antes de 2026: pon aqui su token fijo
# y se usara ese en vez de pedir uno nuevo. Si no, deja esta linea comentada.
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto con el que Shopify FIRMA los webhooks. Ojo, depende de como los crees:
#
#   a) Webhook creado a mano en Settings -> Notifications -> Webhooks
#      -> usa el "webhook signing secret" que aparece al final de ESA pagina.
#
#   b) Webhook creado por la app via Admin API
#      -> usa la "API secret key" de la custom app.
#
# Si eres nuevo, ve por la opcion (a): es apuntar y hacer clic.
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Version de la Admin API (formato AAAA-MM, se actualiza cada trimestre).
SHOPIFY_API_VERSION=2026-07

# Clave de Groq para el agente de IA (gratis en console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Puerto del servidor local
PORT=3002
