{% comment %}
  Etiquetas meta de todas las paginas: Open Graph, tarjetas de Twitter y SEO.

  Tres arreglos respecto al original del tema:
  1. og:image de reserva. El tema solo lo emitia si la pagina tenia imagen
     propia. Los productos y las colecciones la tienen; la portada y las
     paginas sueltas, no. Al pegar el enlace en WhatsApp salia un recuadro
     vacio.
  2. twitter:image, que no existia pese a declarar summary_large_image.
  3. El nombre de la tienda esta guardado con un espacio al final. Se limpia
     con strip aqui, aunque el arreglo de verdad es quitarlo en Configuracion:
     Apple Pay y los datos estructurados lo cogen de ahi, no del tema.
{% endcomment %}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="">

{%- liquid
  assign nombre_tienda = shop.name | strip
  assign og_title = page_title | default: nombre_tienda
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: nombre_tienda

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  comment
    file_url devuelve la ruta sin protocolo, y los rastreadores de Facebook y
    WhatsApp la necesitan absoluta.
  endcomment
  assign imagen_de_reserva = 'patitascalidas-compartir.jpg' | file_url
  unless imagen_de_reserva contains '://'
    assign imagen_de_reserva = imagen_de_reserva | prepend: 'https:'
  endunless
%}

<meta property="og:site_name" content="{{ nombre_tienda }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta name="twitter:image" content="https:{{ page_image | image_url }}">
{%- elsif imagen_de_reserva != blank -%}
  <meta property="og:image" content="{{ imagen_de_reserva }}">
  <meta property="og:image:secure_url" content="{{ imagen_de_reserva }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Patitascalidas: accesorios para perros que resuelven algo">
  <meta name="twitter:image" content="{{ imagen_de_reserva }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; pagina {{ current_page }}{% endif -%}
  {%- unless page_title contains nombre_tienda %} &ndash; {{ nombre_tienda }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{% if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
{% endif %}
