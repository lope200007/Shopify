{%- comment -%}
  Las dos puertas de la portada: perro y gato.

  Por que existe: la tienda vende para dos animales distintos y el visitante
  llega sabiendo cual de los dos tiene. Antes habia que bajar hasta la rejilla
  de categorias y buscar entre seis tarjetas iguales. Aqui se decide en el
  primer vistazo.

  La foto sale de la propia coleccion (su imagen de portada). Si una coleccion
  no tiene foto, la tarjeta se pinta igual con el color de fondo: no se rompe.

  En movil las dos tarjetas se apilan. Es a proposito: en una pantalla estrecha
  dos tarjetas de 50 % dejan el texto ilegible.
{%- endcomment -%}

<div class="pcj pcj-caminos-seccion" id="pcj-{{ section.id }}">
  <div class="pcj-wrap">
    <section class="pcj-seccion" aria-labelledby="titulo-caminos-{{ section.id }}">
      {%- if section.settings.antetitulo != blank or section.settings.titulo != blank -%}
        <div class="pcj-cabecera" data-aparece>
          <div>
            {%- if section.settings.antetitulo != blank -%}
              <p class="pcj-antetitulo">{{ section.settings.antetitulo | escape }}</p>
            {%- endif -%}
            {%- if section.settings.titulo != blank -%}
              <h2 id="titulo-caminos-{{ section.id }}">{{ section.settings.titulo | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.entradilla != blank -%}
              <p>{{ section.settings.entradilla | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="pcj-caminos">
        {%- for bloque in section.blocks -%}
          {%- assign col = collections[bloque.settings.coleccion] -%}
          {%- if col != blank -%}
            <a
              class="pcj-camino"
              href="{{ col.url }}"
              data-aparece
              style="--pcj-orden:{{ forloop.index0 }}"
              {{ bloque.shopify_attributes }}
            >
              {%- if col.image -%}
                <img
                  src="{{ col.image | image_url: width: 1200 }}"
                  srcset="{{ col.image | image_url: width: 600 }} 600w, {{ col.image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 900px) 50vw, 100vw"
                  alt=""
                  width="1200"
                  height="800"
                  loading="lazy"
                >
              {%- endif -%}
              <span class="pcj-camino-texto">
                {%- if bloque.settings.etiqueta != blank -%}
                  <span class="pcj-chip">{{ bloque.settings.etiqueta | escape }}</span>
                {%- endif -%}
                <span class="pcj-camino-titulo">{{ bloque.settings.titulo | default: col.title | escape }}</span>
                {%- if bloque.settings.texto != blank -%}
                  <span class="pcj-camino-lead">{{ bloque.settings.texto | escape }}</span>
                {%- endif -%}
                <span class="pcj-camino-enlace">{{ bloque.settings.enlace | default: 'Explorar' | escape }} &rarr;</span>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  </div>
</div>

{% stylesheet %}
  .pcj-caminos-seccion .pcj-seccion { margin-bottom: 56px; }

  .pcj .pcj-caminos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .pcj .pcj-camino {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--verde);
    box-shadow: var(--sombra);
    transition: transform .3s cubic-bezier(.22, 1, .36, 1), box-shadow .3s;
  }
  @media (hover: hover) {
    .pcj .pcj-camino:hover { transform: translateY(-4px); box-shadow: 0 18px 38px rgba(35, 38, 31, .18); }
    .pcj .pcj-camino:hover img { transform: scale(1.04); }
  }

  .pcj .pcj-camino img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1);
  }

  /* El degradado es lo que hace legible el texto sobre cualquier foto.
     Sin el, una foto clara dejaria el titulo blanco sobre blanco. */
  .pcj .pcj-camino::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(35, 38, 31, .08) 0%, rgba(35, 38, 31, .58) 55%, rgba(35, 38, 31, .86) 100%);
  }

  .pcj .pcj-camino-texto {
    position: relative;
    z-index: 1;
    padding: 28px;
    color: #fff;
    width: 100%;
  }

  .pcj .pcj-chip {
    display: inline-block;
    margin-bottom: 12px;
    padding: 6px 13px;
    border-radius: 999px;
    background: var(--arena);
    color: var(--tinta);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .pcj .pcj-camino-titulo {
    display: block;
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.08;
  }

  .pcj .pcj-camino-lead {
    display: block;
    margin-top: 8px;
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.45;
    color: rgba(255, 255, 255, .92);
    text-wrap: pretty;
  }

  .pcj .pcj-camino-enlace {
    display: inline-block;
    margin-top: 16px;
    font-weight: 700;
    border-bottom: 2px solid rgba(255, 255, 255, .55);
    padding-bottom: 2px;
  }

  @media (max-width: 860px) {
    .pcj .pcj-caminos { grid-template-columns: 1fr; gap: 14px; }
    .pcj .pcj-camino { min-height: 300px; }
    .pcj .pcj-camino-texto { padding: 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcj .pcj-camino, .pcj .pcj-camino img { transition: none; }
    .pcj .pcj-camino:hover { transform: none; }
    .pcj .pcj-camino:hover img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Perro o gato",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "antetitulo", "label": "Antetitulo", "default": "Para vidas con patas" },
    { "type": "text", "id": "titulo", "label": "Titulo", "default": "Pequenos detalles para grandes companeros" },
    { "type": "textarea", "id": "entradilla", "label": "Entradilla", "default": "Elige por quien vives: todo lo de perro por un lado y todo lo de gato por otro." }
  ],
  "blocks": [
    {
      "type": "camino",
      "name": "Tarjeta",
      "settings": [
        { "type": "collection", "id": "coleccion", "label": "Coleccion" },
        { "type": "text", "id": "etiqueta", "label": "Etiqueta pequena" },
        { "type": "text", "id": "titulo", "label": "Titulo", "info": "Si lo dejas vacio se usa el nombre de la coleccion." },
        { "type": "textarea", "id": "texto", "label": "Texto" },
        { "type": "text", "id": "enlace", "label": "Texto del enlace", "default": "Explorar" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    { "name": "Perro o gato", "blocks": [{ "type": "camino" }, { "type": "camino" }] }
  ]
}
{% endschema %}
