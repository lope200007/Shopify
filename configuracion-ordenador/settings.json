{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",

    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",

      "Read(~/AppData/Local/Google/Chrome/User Data/**)",
      "Read(~/AppData/Local/Microsoft/Edge/User Data/**)",
      "Read(~/AppData/Roaming/Mozilla/**)",
      "Read(~/AppData/Local/Microsoft/Credentials/**)",
      "Read(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Vault/**)",
      "Read(~/AppData/Roaming/Microsoft/Protect/**)",

      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/.mcp.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials*.json)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.git-credentials)",

      "Read(~/Documents/Banco/**)",
      "Read(~/Documents/Privado/**)",
      "Read(~/Escritorio/Privado/**)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(history*)",
      "Bash(env)",
      "Bash(printenv*)",
      "PowerShell(Remove-Item * -Recurse -Force)",
      "PowerShell(Get-Credential*)",
      "PowerShell(ConvertFrom-SecureString*)",
      "PowerShell(Get-Content * -Raw | Invoke-Expression)",
      "PowerShell(Invoke-Expression*)",
      "PowerShell(Get-ChildItem Env:*)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(npm publish*)",
      "Bash(curl * -d *)",
      "Bash(curl * --data*)",
      "Bash(curl * -F *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "PowerShell(Invoke-WebRequest * -Method Post*)",
      "PowerShell(Invoke-RestMethod * -Method Post*)"
    ]
  }
}
